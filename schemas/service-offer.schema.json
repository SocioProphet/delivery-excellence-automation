{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.invalid/schemas/service-offer.schema.json",
  "title": "ServiceOffer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "offer_id",
    "name",
    "buyer_problem",
    "stages",
    "excluded_actions",
    "managed_service_follow_on"
  ],
  "properties": {
    "version": { "type": "string" },
    "offer_id": { "type": "string" },
    "name": { "type": "string" },
    "buyer_problem": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "excluded_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_model": {
      "type": "array",
      "items": { "type": "string" }
    },
    "managed_service_follow_on": { "type": "boolean" },
    "target_kpis": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
