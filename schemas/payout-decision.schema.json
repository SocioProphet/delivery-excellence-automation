{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.invalid/schemas/payout-decision.schema.json",
  "title": "PayoutDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "payout_decision_id",
    "engagement_id",
    "gate_id",
    "status",
    "decision_owner",
    "evidence_links"
  ],
  "properties": {
    "version": { "type": "string" },
    "payout_decision_id": { "type": "string" },
    "engagement_id": { "type": "string" },
    "gate_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "blocked", "rejected", "paid"]
    },
    "decision_owner": { "type": "string" },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "reusable_asset_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exception_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escrow_reference_id": { "type": "string" },
    "amount": { "type": "number", "minimum": 0 },
    "currency": { "type": "string" },
    "rationale": { "type": "string" }
  }
}
