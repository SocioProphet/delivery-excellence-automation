{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.invalid/schemas/control-loop.schema.json",
  "title": "ControlLoop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "control_loop_id",
    "trigger",
    "context_sources",
    "allowed_tools",
    "action_classes",
    "approval_rule",
    "exception_route",
    "emitted_evidence",
    "target_kpis"
  ],
  "properties": {
    "version": { "type": "string" },
    "control_loop_id": { "type": "string" },
    "trigger": { "type": "string" },
    "context_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "action_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["A0", "A1", "A2", "A3", "A4"]
      }
    },
    "approval_rule": { "type": "string" },
    "exception_route": { "type": "string" },
    "emitted_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target_kpis": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
